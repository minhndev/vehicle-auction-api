# App config
SERVER_PORT=your_server_port
SPRING_PROFILES_ACTIVE=dev
APP_NAME=vehicle-auction-api
TIME_ZONE=your_time_zone

# Database config
POSTGRES_HOST=your_postgres_host
POSTGRES_PORT=your_postgres_port
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_name_database

MONGO_URI=your_mongodb_uri

REDIS_HOST=your_redis_host
REDIS_PORT=your_redis_port
REDIS_PASSWORD=your_redis_password

# Security
JWT_ACCESS_SECRET=your_access_secret
JWT_REFRESH_SECRET=your_refresh_secret
JWT_ACCESS_EXPIRATION=your_access_expiration
JWT_REFRESH_EXPIRATION=your_refresh_expiration

# Mail service
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_password
MAIL_FROM_ADDRESS=your_email_address

# Payment gateway
VNPAY_PAY_URL=your_vnpay_pay_url
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_RETURN_URL=your_vnpay_return_url

# Admin account
ADMIN_EMAIL=your_admin_email
ADMIN_PASSWORD=your_admin_password

# API URL
API_BASE_URL=your_api_url

# Frontend URL
FRONTEND_URL=your_frontend_url

# AWS S3
AWS_S3_ENDPOINT=your_value
AWS_S3_BUCKET_NAME=your_value
AWS_S3_REGION=your_value
AWS_S3_ACCESS_KEY=your_value
AWS_S3_SECRET_KEY=your_value

# OAuth2
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret